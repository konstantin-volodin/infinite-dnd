*... immediate action context ...*

## action
- actor: {{ char.id }}
- description: {{ description }}
{% if target %}
- target: {{ target }}
{% endif %}

## actor state
- role: {{ char.role or 'unknown' }}
- condition: {{ health_status }} ({{ char.stats.hp }}/{{ char.stats.max_hp }} HP)
- gold: {{ char.stats.gold }}
- goal: {{ char.goal or 'none' }}
{% if char.inventory %}
- inventory: {{ char.inventory | join(', ') }}
{% endif %}
{% if char.knowledge %}
- recent knowledge: {{ char.knowledge[-5:] | join(', ') }}
{% endif %}

## location
{% if loc %}
- place: {{ loc.id }}
- description: {{ loc.description or 'no description' }}
{% if loc.features %}
- features: {{ loc.features | join(', ') }}
{% endif %}
{% if loc.items %}
- items here: {{ loc.items | join(', ') }}
{% endif %}
{% if loc.connections %}
- exits: {{ loc.connections | join(', ') }}
{% endif %}
{% if others %}
- others present: {{ others | join(', ') }}
{% endif %}
{% else %}
- place: unknown
{% endif %}

{% if target_character or target_location or target_item %}
## target resolution
{% if target_character %}
- target character: {{ target_character.id }} at {{ target_character.location }}
{% endif %}
{% if target_location %}
- target location: {{ target_location.id }}
{% endif %}
{% if target_item %}
- target item: {{ target_item }}
{% endif %}
{% endif %}

{% if quests %}
## active quests
{% for q in quests %}
- {{ q.title }} ({{ q.status }}; owner: {{ q.owner or 'unassigned' }})
{% if q.plan and q.current_step < q.plan|length %}
  - current objective: {{ q.plan[q.current_step] }}
{% endif %}
{% endfor %}
{% endif %}

{% if chronicle %}
## chronicle (long-term memory, oldest first)
{% for entry in chronicle %}
- {{ entry }}
{% endfor %}
{% endif %}
## recent events
{% if recent_events %}
{% for event in recent_events %}
- {{ event }}
{% endfor %}
{% else %}
- no recent events
{% endif %}

---

resolve the action now. use tools for durable state changes, then call `done` with a one-sentence mechanical summary of what changed — no scene-setting, no flourishes.
